{
  "name": "the-last-turn",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "node scripts/run-coverage.mjs",
    "test:coverage:scoped": "node scripts/run-coverage.mjs src/app && node scripts/run-coverage.mjs src/ui && node scripts/run-coverage.mjs src/game",
    "test:coverage:server": "node scripts/run-coverage.mjs functions/_lib && node scripts/run-coverage.mjs functions/api",
    "db:migrate:local": "wrangler d1 migrations apply the-last-turn --local",
    "db:migrate": "wrangler d1 migrations apply the-last-turn --remote",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=the-last-turn",
    "check:budget": "node scripts/check-budget.mjs",
    "check:residues": "node scripts/residue-sweep.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test:coverage && npm run test:coverage:scoped && npm run test:coverage:server && npm run build && npm run check:budget && npm run check:residues"
  },
  "dependencies": {
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.1",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.1",
    "wrangler": "^4.144.0"
  }
}
